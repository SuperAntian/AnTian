# 爬虫配置
CRAWL_INTERVAL=600
REQUEST_TIMEOUT=10
RETRY_TIMES=3

# 存储配置
STORAGE_TYPE=sqlite
DB_PATH=data/news.db
CSV_DIR=data

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/crawler.log

# 你的API TOKEN（可选）
# Tushare 注册地址: https://tushare.pro/register?reg=1
TUSHARE_TOKEN=your_tushare_token_here

# Xueqiu 需要手动设置
XUEQIU_TOKEN=
